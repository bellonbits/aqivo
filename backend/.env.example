# Copy to .env — never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://mac@localhost:5432/bizora
SECRET_KEY=change-me-to-a-long-random-string
BASE_DOMAIN=aqivo.shop
PUBLIC_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MEDIA_DIR=storage
# Email (leave SMTP_HOST empty to log emails instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Aqivo <hello@aqivo.shop>
# M-Pesa Daraja (leave empty => "Not configured")
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
MPESA_ENV=sandbox
# Optional: enables LLM drafting in Bizora AI. Without it, drafts use built-in templates.
ANTHROPIC_API_KEY=
