{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://143.198.30.249/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "http://143.198.30.249/media/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "http://143.198.30.249/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
