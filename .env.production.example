# ==============================================================================
# AQIVO PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

ENVIRONMENT=production
SECRET_KEY=dev-secret-aqivo-production-key-change-me-later-32chars
BASE_DOMAIN=aqivo.shop
PUBLIC_BASE_URL=https://aqivo.shop
APP_BASE_URL=https://www.aqivo.shop
CORS_ORIGINS=https://aqivo.shop,https://www.aqivo.shop,https://app.aqivo.shop
CUSTOM_DOMAIN_CNAME=domains.aqivo.shop

# Managed PostgreSQL (Aiven)
DATABASE_URL=postgresql+psycopg://avnadmin:YOUR_AIVEN_PASSWORD@pg-22880706-aqivo.f.aivencloud.com:14679/defaultdb?sslmode=require
# Connection pool settings (keeps total pool under managed DB max_connections limit)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=300

# Media storage path
MEDIA_DIR=/app/storage
