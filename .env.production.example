# ==============================================================================
# AQIVO PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

ENVIRONMENT=production
SECRET_KEY=dev-secret-aqivo-production-key-change-me-later-32chars
BASE_DOMAIN=aqivo.shop
PUBLIC_BASE_URL=https://aqivo.shop
APP_BASE_URL=https://www.aqivo.shop
CORS_ORIGINS=https://aqivo.shop,https://www.aqivo.shop,https://app.aqivo.shop
CUSTOM_DOMAIN_CNAME=domains.aqivo.shop
HTTP_PORT=8080
HTTPS_PORT=8443

# Managed PostgreSQL (Supabase)
# Direct IPv6: postgresql+psycopg://postgres:YOUR_SUPABASE_PASSWORD@db.wrwvthjtapfchkfotums.supabase.co:5432/postgres
# IPv4 Pooler (Recommended): postgresql+psycopg://postgres.wrwvthjtapfchkfotums:YOUR_SUPABASE_PASSWORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres.wrwvthjtapfchkfotums:YOUR_SUPABASE_PASSWORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
# Connection pool settings (5 base + 5 overflow per worker; 2 workers = 20 conns max)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Media storage path
MEDIA_DIR=/app/storage

# Redis Cache Service
REDIS_URL=redis://redis:6379/0

# Platform Super Admin Configuration
ADMIN_EMAIL=admin@aqivo.shop
ADMIN_PASSWORD=change-me-to-a-secure-super-admin-password
ADMIN_NAME=Aqivo Super Admin
