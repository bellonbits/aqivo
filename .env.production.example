# ==============================================================================
# AQIVO PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application
ENVIRONMENT=production
SECRET_KEY=replace_with_a_64_character_random_hex_or_base64_string
BASE_DOMAIN=aqivo.shop
PUBLIC_BASE_URL=https://aqivo.shop
APP_BASE_URL=https://aqivo.shop
CORS_ORIGINS=https://aqivo.shop,https://app.aqivo.shop
CUSTOM_DOMAIN_CNAME=domains.aqivo.shop
CUSTOM_DOMAIN_IPS=your_server_public_ip

# PostgreSQL Container Credentials
POSTGRES_USER=aqivo
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=aqivo

# SSL & Caddy
ACME_EMAIL=hello@aqivo.shop

# Email / SMTP (optional, leave empty to log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Aqivo <hello@aqivo.shop>

# M-Pesa Daraja (optional)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
MPESA_ENV=sandbox

# Optional Anthropic API Key for AI Assistant
ANTHROPIC_API_KEY=
