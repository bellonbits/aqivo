{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:slug/",
      "destination": "/:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://143.198.30.249/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "http://143.198.30.249/media/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "http://143.198.30.249/static/:path*"
    },
    {
      "source": "/docs",
      "destination": "http://143.198.30.249/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "http://143.198.30.249/openapi.json"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/onboarding",
      "destination": "/index.html"
    },
    {
      "source": "/templates",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/ecomm-templates/:path*",
      "destination": "http://143.198.30.249/ecomm-templates/:path*"
    },
    {
      "source": "/:slug",
      "destination": "http://143.198.30.249/:slug"
    },
    {
      "source": "/:slug/",
      "destination": "http://143.198.30.249/:slug"
    },
    {
      "source": "/:slug/:path*",
      "destination": "http://143.198.30.249/:slug/:path*"
    }
  ]
}
